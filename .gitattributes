# Overrides for GitHub's language statistics (Linguist):
# https://github.com/github-linguist/linguist/blob/main/docs/overrides.md
# Attribute patterns do not recurse into directories, so a folder needs `/**`.

# The documentation site, including its example script.
docs/** linguist-documentation

# Pico CSS, d3 and Observable Plot with their licences, copied from their npm packages.
# `alphatonic.css` and `alphatonic.js` beside them are ours and stay counted, which is why this
# lists the files and not the folder.
src/alphatonic/report/static/pico.classless.min.css linguist-vendored
src/alphatonic/report/static/pico.LICENSE.md linguist-vendored
src/alphatonic/report/static/d3.min.js linguist-vendored
src/alphatonic/report/static/d3.LICENSE.md linguist-vendored
src/alphatonic/report/static/plot.umd.min.js linguist-vendored
src/alphatonic/report/static/plot.LICENSE.md linguist-vendored
